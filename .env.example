# Copy to .env.local and fill in. `.env*` is gitignored; never commit real keys.
#
# Supabase dashboard > Project Settings > API.

# ---------------------------------------------------------------------------
# Public. Shipped to the browser, and that is fine: every query this key makes
# is filtered by row-level security. The policy is the security boundary, not
# the key.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects issue a legacy anon JWT instead; either name works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# ---------------------------------------------------------------------------
# Secret. Bypasses row-level security completely.
#
# Used by `npm run content:seed` and nothing else. It has no NEXT_PUBLIC_
# prefix on purpose, so Next cannot inline it into a client bundle even by
# accident. If this key ever appears in a browser, rotate it.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...
# Newer projects also issue an `sb_secret_…` key, readable as SUPABASE_SECRET_KEY.
# Check it works before relying on it: on this project the sb_secret_ key 401s
# against the data API while the legacy service_role JWT succeeds, so the two
# are not yet interchangeable.
# SUPABASE_SECRET_KEY=sb_secret_xxx

# ---------------------------------------------------------------------------
# Optional: Google OAuth (PRD F1).
#
# Three steps, all required — the button hides itself until the last one, so a
# half-configured provider shows nothing rather than a button that fails:
#   1. create the OAuth client, set these two;
#   2. enabled = true under [auth.external.google] in supabase/config.toml,
#      then `npx supabase config push`;
#   3. NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=1.
# ---------------------------------------------------------------------------
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=1

# ---------------------------------------------------------------------------
# Optional: for `npm run test:rls`, which signs two throwaway users in and
# proves one cannot read the other's rows. Needs the secret key above plus a
# project it is safe to create users in -- a local stack or a scratch project,
# never production.
# ---------------------------------------------------------------------------
# RLS_TEST_ENABLED=1
